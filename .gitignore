# bench baselines are transient, except the tracked pre-rewrite baseline
bench/baselines/*
!bench/baselines/focei_theoph_pre_rewrite.rds

# Python caches from the reticulate helpers under inst/code
__pycache__/
*.pyc

# Local tooling
.positai
.claude/
CLAUDE.md

# compile() object-reuse index
.dMod_objects

# Third-party fixture trees. Resolved at test time via DMOD_PETABTESTS /
