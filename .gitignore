# Codegen and solver outputs written by tests under tests/testthat
tests/testthat/*.c
tests/testthat/*.cpp
tests/testthat/*.o
tests/testthat/*.so
tests/testthat/*.dll
tests/testthat/reactions_for_Alyssa*
