  res3 <- symmetryDetection(f3, g3, reconstruct = TRUE)
  red3 <- symmetryReduction(res3)
  symmetryDetection(f3, g3, trafo = red3$trafo)$identifiable

  ## rational invariant via the separable quadrature stage
  f4 <- eqnvec(x = "-(b - a)/(a*b)*x")
