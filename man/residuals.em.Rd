pr <- predict(fit)
pr <- pr[pr$source == "obs", ]
head(data.frame(pr[c("condition", "time", "observed", "IPRED", "PRED")],
                IWRES = residuals(fit), CWRES = residuals(fit, type = "CWRES"),
                PWRES = residuals(fit, type = "PWRES")))

